diff --git a/ui/vnc.c b/ui/vnc.c
--- a/ui/vnc.c
+++ b/ui/vnc.c
@@ -3096,3 +3096,22 @@
+/* Called by s5l8960x at vblank, with BQL held. Keep upstream refresh as a
+ * fallback for connect, paused consoles, worker contention and other boards;
+ * do not use an unconditional 8 ms framebuffer poll. Socket input remains
+ * driven by its existing fd handlers, independently of display refresh.
+ */
+void vphone_vnc_refresh(QemuConsole *con);
+void vphone_vnc_refresh(QemuConsole *con)
+{
+    VncDisplay *vd;
+
+    QTAILQ_FOREACH(vd, &vnc_displays, next) {
+        if (!QTAILQ_EMPTY(&vd->clients) &&
+            (vd->dcl.con == con ||
+             (!vd->dcl.con && con == qemu_console_lookup_default()))) {
+            vnc_refresh(&vd->dcl);
+        }
+    }
+}
+
