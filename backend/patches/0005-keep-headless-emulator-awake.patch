-                          reason:@"Emulated machine runs in real time"] retain];
 }
 
 - (void)applicationWillTerminate:(NSNotification *)aNotification
@@ -2342,6 +2331,15 @@
 
 static void register_cocoa(void)
 {
+    /* The native player uses -display none and VNC. Keep the QEMU process
+     * itself awake even when Cocoa's NSApplication is never started. */
+    @autoreleasepool {
+        [[[NSProcessInfo processInfo]
+            beginActivityWithOptions:NSActivityUserInitiatedAllowingIdleSystemSleep |
+                                     NSActivityLatencyCritical
+                              reason:@"Emulated machine runs in real time"] retain];
+    }
+    fprintf(stderr, "[vphone] emulator App Nap protection active\n");
     qemu_display_register(&qemu_display_cocoa);
 }
 
