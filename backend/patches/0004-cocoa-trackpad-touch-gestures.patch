+/*
+ * vphone: like the iOS Simulator, trackpad gestures drive touchscreen
+ * fingers through QEMU multi-touch (MTT) slots. A plain click/drag stays
+ * on the absolute pointer path (one finger in the guest).
+ *   two-finger scroll -> one finger dragged by the scroll deltas
+ *   notched wheel     -> short one-finger drag per notch
+ *   Option+drag       -> two fingers mirrored around the pinch centre
+ *   Option+Shift+drag -> both fingers (and the centre) move together
+ *   trackpad pinch    -> two fingers spread by the magnification
+ */
+enum { TOUCH_NONE, TOUCH_SCROLL, TOUCH_WHEEL, TOUCH_PINCH, TOUCH_MAGNIFY };
+#define TOUCH_WHEEL_STEP 40     /* guest pixels per wheel notch */
+#define TOUCH_WHEEL_LIFT 0.15   /* seconds without notches before lift */
+#define TOUCH_MAGNIFY_SPAN 160  /* initial finger distance, guest pixels */
+#define TOUCH_FINGER_SIZE 56    /* overlay dot, guest pixels */
+
 @interface QemuCocoaView : NSView
 {
     QEMUScreen screen;
