--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -1485,17 +1485,6 @@
 {
     COCOA_DEBUG("QemuCocoaAppController: applicationDidFinishLaunching\n");
     allow_events = true;
-    /*
-     * Guest time follows the host clock, so App Nap and timer coalescing
