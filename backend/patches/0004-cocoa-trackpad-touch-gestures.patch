+- (NSPoint) touchPointFromWindow:(NSPoint)p
+{
+    CGFloat d = (CGFloat)screen.height / [self frame].size.height;
+    NSPoint t = NSMakePoint(p.x * d, screen.height - p.y * d);
+    t.x = MAX(0, MIN(t.x, screen.width - 1));
+    t.y = MAX(0, MIN(t.y, screen.height - 1));
+    return t;
+}
+
+- (BOOL) touchPointerInView
+{
+    NSPoint p = [[self window] mouseLocationOutsideOfEventStream];
+    return NSPointInRect([self convertPoint:p fromView:nil], [self bounds]);
+}
+
+- (NSPoint) touchPointer
+{
+    return [self touchPointFromWindow:[[self window] mouseLocationOutsideOfEventStream]];
+}
+
+- (NSPoint) touchMirror:(NSPoint)p
+{
+    if (!pinchCenterSet) {
+        pinchCenter = NSMakePoint(screen.width / 2.0, screen.height / 2.0);
+        pinchCenterSet = true;
+    }
+    return NSMakePoint(2 * pinchCenter.x - p.x, 2 * pinchCenter.y - p.y);
+}
+
+- (void) touchShowFingers:(int)count at:(const NSPoint *)points
+{
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    for (int i = 0; i < 2; i++) {
+        if (i < count) {
+            [fingerLayer[i] setPosition:CGPointMake(points[i].x,
+                                                    screen.height - points[i].y)];
+        }
+        [fingerLayer[i] setHidden:i >= count];
+    }
+    [CATransaction commit];
+}
+
+/* Option held over the screen shows where a pinch would land. */
+- (void) touchHint:(NSUInteger)modifiers
+{
+    bool option = isAbsoluteEnabled && (modifiers & NSEventModifierFlagOption);
+    if (touchGesture != TOUCH_NONE) {
+        return;
+    }
+    if (!option) {
+        pinchCenterSet = false; /* next pinch mirrors around the centre */
+        [self touchShowFingers:0 at:NULL];
+        return;
+    }
+    if (![self touchPointerInView]) {
+        [self touchShowFingers:0 at:NULL];
+        return;
+    }
+    NSPoint hint[2];
+    hint[0] = [self touchPointer];
+    hint[1] = [self touchMirror:hint[0]];
+    [self touchShowFingers:2 at:hint];
+}
+
+- (void) touchSendLocked:(InputMultiTouchType)type
+{
+    for (int i = 0; i < touchFingers; i++) {
+        NSPoint p = touchFinger[i];
+        p.x = MAX(0, MIN(p.x, screen.width - 1));
+        p.y = MAX(0, MIN(p.y, screen.height - 1));
+        touchFinger[i] = p;
+        qemu_input_queue_mtt_abs(dcl.con, INPUT_AXIS_X, p.x, 0, screen.width, i, i);
+        qemu_input_queue_mtt_abs(dcl.con, INPUT_AXIS_Y, p.y, 0, screen.height, i, i);
+        qemu_input_queue_mtt(dcl.con, type, i, i);
+    }
+    qemu_input_event_sync();
+    if (type == INPUT_MULTI_TOUCH_TYPE_END) {
+        touchGesture = TOUCH_NONE;
+        touchFingers = 0;
+        [self touchShowFingers:0 at:NULL];
+        [self touchHint:[NSEvent modifierFlags]];
+    } else if (touchFingers == 2) {
+        [self touchShowFingers:2 at:touchFinger];
+    }
+}
+
+- (void) touchWheelLift:(NSTimer *)timer
+{
+    wheelTimer = nil;
+    with_bql(^{
+        if (touchGesture == TOUCH_WHEEL) {
+            [self touchSendLocked:INPUT_MULTI_TOUCH_TYPE_END];
+        }
+    });
+}
+
+- (void) touchScrollLocked:(NSEvent *)event
+{
+    CGFloat d = (CGFloat)screen.height / [self frame].size.height;
+    NSEventPhase phase = [event phase];
+    bool inView = [event window] == [self window] && [self touchPointerInView];
+
+    if (phase == NSEventPhaseNone && [event momentumPhase] != NSEventPhaseNone) {
+        /* iOS decelerates on its own from the release velocity. */
+        return;
+    }
+    if (phase == NSEventPhaseNone) {
+        /* Notched wheel: a short drag per notch, lifted after a pause. */
+        if (touchGesture == TOUCH_NONE && inView) {
+            touchGesture = TOUCH_WHEEL;
+            touchFingers = 1;
+            touchFinger[0] = [self touchPointer];
+            [self touchSendLocked:INPUT_MULTI_TOUCH_TYPE_BEGIN];
+        }
+        if (touchGesture != TOUCH_WHEEL) {
+            return;
+        }
+        CGFloat scale = [event hasPreciseScrollingDeltas] ? d : TOUCH_WHEEL_STEP;
+        touchFinger[0].x += [event scrollingDeltaX] * scale;
+        touchFinger[0].y += [event scrollingDeltaY] * scale;
+        [self touchSendLocked:INPUT_MULTI_TOUCH_TYPE_UPDATE];
+        [wheelTimer invalidate];
+        wheelTimer = [NSTimer scheduledTimerWithTimeInterval:TOUCH_WHEEL_LIFT
+                                                      target:self
+                                                    selector:@selector(touchWheelLift:)
+                                                    userInfo:nil
+                                                     repeats:NO];
+        return;
+    }
+    if (phase & NSEventPhaseBegan) {
+        if (touchGesture != TOUCH_NONE || !inView) {
+            return;
+        }
+        touchGesture = TOUCH_SCROLL;
+        touchFingers = 1;
+        touchFinger[0] = [self touchPointer];
+        [self touchSendLocked:INPUT_MULTI_TOUCH_TYPE_BEGIN];
+    } else if (touchGesture != TOUCH_SCROLL) {
+        return;
+    }
+    if (phase & NSEventPhaseChanged) {
+        /* Deltas already follow the host's scroll direction setting. */
+        touchFinger[0].x += [event scrollingDeltaX] * d;
+        touchFinger[0].y += [event scrollingDeltaY] * d;
+        [self touchSendLocked:INPUT_MULTI_TOUCH_TYPE_UPDATE];
+    }
+    if (phase & (NSEventPhaseEnded | NSEventPhaseCancelled)) {
+        [self touchSendLocked:INPUT_MULTI_TOUCH_TYPE_END];
+    }
+}
+
+/* Option+click starts a two-finger pinch; returns true when consumed. */
+- (bool) touchPinchEvent:(NSEvent *)event type:(InputMultiTouchType)type
+{
+    NSUInteger modifiers = [event modifierFlags];
+    if (type == INPUT_MULTI_TOUCH_TYPE_BEGIN) {
+        if (!isAbsoluteEnabled || !isMouseGrabbed || touchGesture != TOUCH_NONE ||
+            !(modifiers & NSEventModifierFlagOption)) {
+            return false;
+        }
+    } else if (touchGesture != TOUCH_PINCH) {
+        return false;
+    }
+    NSPoint p = [self touchPointFromWindow:[event locationInWindow]];
+    with_bql(^{
+        if (type == INPUT_MULTI_TOUCH_TYPE_BEGIN) {
+            touchGesture = TOUCH_PINCH;
+            touchFingers = 2;
+        } else if (modifiers & NSEventModifierFlagShift) {
+            pinchCenter.x += p.x - touchFinger[0].x;
+            pinchCenter.y += p.y - touchFinger[0].y;
+        }
+        touchFinger[0] = p;
+        touchFinger[1] = [self touchMirror:p];
+        [self touchSendLocked:type];
+    });
+    return true;
+}
+
+- (void) magnifyWithEvent:(NSEvent *)event
+{
+    NSEventPhase phase = [event phase];
+    if (!isAbsoluteEnabled) {
+        return;
+    }
+    with_bql(^{
+        InputMultiTouchType type = INPUT_MULTI_TOUCH_TYPE_UPDATE;
+        if (phase & NSEventPhaseBegan) {
+            if (touchGesture != TOUCH_NONE || ![self touchPointerInView]) {
+                return;
+            }
+            touchGesture = TOUCH_MAGNIFY;
+            touchFingers = 2;
+            magnifyCenter = [self touchPointer];
+            magnifyScale = 1;
+            type = INPUT_MULTI_TOUCH_TYPE_BEGIN;
+        } else if (touchGesture != TOUCH_MAGNIFY) {
+            return;
+        }
+        magnifyScale = MAX(0.1, magnifyScale + [event magnification]);
+        CGFloat r = MIN(TOUCH_MAGNIFY_SPAN / 2.0 * magnifyScale, screen.height);
+        touchFinger[0] = NSMakePoint(magnifyCenter.x - r, magnifyCenter.y);
+        touchFinger[1] = NSMakePoint(magnifyCenter.x + r, magnifyCenter.y);
+        if (phase & (NSEventPhaseEnded | NSEventPhaseCancelled)) {
+            type = INPUT_MULTI_TOUCH_TYPE_END;
+        }
+        [self touchSendLocked:type];
+    });
+}
